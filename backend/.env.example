# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ticketing_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CLIENT_URL="http://localhost:5173"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Ticketing System <your-email@gmail.com>"

# Workhub24
WORKHUB_BASE_URL="https://app.workhub24.com"
WORKHUB_TENANT_ID="your-tenant-id"
WORKHUB_WORKFLOW_ID="your-workflow-id"
WORKHUB_API_USERNAME="your-workhub-username"
WORKHUB_API_PASSWORD="your-workhub-password"

# File uploads
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10
